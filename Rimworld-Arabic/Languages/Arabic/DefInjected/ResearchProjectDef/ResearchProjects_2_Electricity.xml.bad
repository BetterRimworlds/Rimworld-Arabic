    <li>subject_def2->ﺇﻟﻰ ﺍﻟﺒﻄﺎﺭﻳﺎﺕ</li>
    <li>subject_story->ﺍﻛﺘﺸﻒ ﺃﻥ ﺑﺤﻴﺮﺓً ﺣﻤﻀﻴﺔ ﻋﻠﻰ ﺍﻟﺸﻮﺍﻃﺊ ﺍﻟﺮﺻﺎﺻﻴﺔ ﻟﻌﺎﻟﻢ ﻣﻮﺕ ﻛﺎﻧﺖ ﺗﻌﻤﻞ ﻛﺒﻄﺎﺭﻳﺔ ﻃﺒﻴﻌﻴﺔ</li>
    <li>subject_story->ﻛﺎﻥ ﻣﺴﺆﻭﻟًﺎ ﻋﻦ ﺍﻟﺤﻔﺎﻅ ﻋﻠﻰ ﺩﻋﻢ ﺍﻟﺤﻴﺎﺓ ﺇﺫﺍ ﻓﻘﺪﺕ ﺍﻟﻤﺴﺘﻌﻤﺮﺓ ﺍﻟﻄﺎﻗﺔ</li>
    <li>subject_story->ﻋﻤﻞ ﻓﻲ ﻋﻮﺍﻟﻢ ﺍﻟﺨﺮﺩﺓ، ﻣُﺼﻠﺤًﺎ ﺍﻵﻻﺕ ﻭﺍﻟﺒﻄﺎﺭﻳﺎﺕ</li>
    <li>subject_gerund->ﺑﻨﺎﺀ ﺑﻄﺎﺭﻳﺎﺕ</li>
  </Batteries.generalRules.rulesStrings>

  <!-- EN: biofuel refining -->
  <BiofuelRefining.label>ﺗﻜﺮﻳﺮ ﺍﻟﻮﻗﻮﺩ ﺍﻟﺤﻴﻮﻱ</BiofuelRefining.label>
  <!-- EN: Build biofuel refineries to make chemfuel from biological matter like wood or foodstuffs. -->
  <BiofuelRefining.description>ﺍﺑﻦِ ﻣﺼﺎﻓﻲ ﻭﻗﻮﺩ ﺣﻴﻮﻱ ﻟﺼﻨﻊ chemfuel ﻣﻦ ﻣﻮﺍﺩ ﺑﻴﻮﻟﻮﺟﻴﺔ ﻣﺜﻞ ﺍﻟﺨﺸﺐ ﺃﻭ ﺍﻟﻤﻮﺍﺩ ﺍﻟﻐﺬﺍﺋﻴﺔ.</BiofuelRefining.description>
  <!-- EN:
    <li>subject->biofuel</li>
    <li>subject_story->was trapped when a generation ship lost power. [ANYPAWN_pronoun] used [ANYPAWN_possessive] knowledge of refining to turn human remains into biofuel and restart the engines</li>
    <li>subject_story->used automated biorefineries to begin the long terraforming process on an iceworld</li>
    <li>subject_story->started a distillery to make moonshine but, realizing it was undrinkable, sold it as chemfuel instead</li>
    <li>subject_gerund->refining biofuel</li>
  -->
  <BiofuelRefining.generalRules.rulesStrings>
    <li>subject->ﻭﻗﻮﺩ ﺣﻴﻮﻱ</li>
    <li>subject_FemMas->ﺍﻟﻮﻗﻮﺩ ﺍﻟﺤﻴﻮﻱ</li>
    <li>subject_def->ﻟﻠﻮﻗﻮﺩ ﺍﻟﺤﻴﻮﻱ</li>
    <li>subject_def2->ﺇﻟﻰ ﺍﻟﻮﻗﻮﺩ ﺍﻟﺤﻴﻮﻱ</li>
    <li>subject_story->ﻋُﻠِﻖ ﻋﻨﺪﻣﺎ ﻓﻘﺪﺕ ﺳﻔﻴﻨﺔ ﺃﺟﻴﺎﻝ ﺍﻟﻄﺎﻗﺔ. ﺍﺳﺘﺨﺪﻡ [ANYPAWN_pronoun] ﻣﻌﺮﻓﺔ [ANYPAWN_possessive] ﺑﺎﻟﺘﻜﺮﻳﺮ ﻟﺘﺤﻮﻳﻞ ﺑﻘﺎﻳﺎ ﺑﺸﺮﻳﺔ ﺇﻟﻰ ﻭﻗﻮﺩ ﺣﻴﻮﻱ ﻭﺇﻋﺎﺩﺓ ﺗﺸﻐﻴﻞ ﺍﻟﻤﺤﺮﻛﺎﺕ</li>
    <li>subject_story->ﺍﺳﺘﺨﺪﻡ ﻣﺼﺎﻓﻲ ﻭﻗﻮﺩ ﺣﻴﻮﻱ ﺁﻟﻴﺔ ﻟﺒﺪﺀ ﻋﻤﻠﻴﺔ ﺍﻟﺘﺸﻜﻴﻞ ﺍﻷﺭﺿﻲ ﺍﻟﻄﻮﻳﻠﺔ ﻋﻠﻰ ﻋﺎﻟﻢ ﺟﻠﻴﺪﻱ</li>
    <li>subject_story->ﺃﻧﺸﺄ ﻣﻌﻤﻞ ﺗﻘﻄﻴﺮ ﻟﺼﻨﻊ ﻣﺸﺮﻭﺏ ﻣُﻬﺮَّﺏ، ﻟﻜﻦ ﺣﻴﻦ ﺃﺩﺭﻙ ﺃﻧﻪ ﻏﻴﺮ ﺻﺎﻟﺢ ﻟﻠﺸﺮﺏ ﺑﺎﻋﻪ ﻙـ chemfuel ﺑﺪﻟًﺎ ﻣﻦ ﺫﻟﻚ</li>
    <li>subject_gerund->ﺗﻜﺮﻳﺮ ﺍﻟﻮﻗﻮﺩ ﺍﻟﺤﻴﻮﻱ</li>
  </BiofuelRefining.generalRules.rulesStrings>

  <!-- EN: blowback operation -->
  <BlowbackOperation.label>ﺗﺸﻐﻴﻞ ﺍﻻﺭﺗﺪﺍﺩ</BlowbackOperation.label>
  <!-- EN: Craft low-power blowback-operated guns like autopistols and machine pistols. -->
  <BlowbackOperation.description>ﺍﺻﻨﻊ ﺃﺳﻠﺤﺔ ﻣﻨﺨﻔﻀﺔ ﺍﻟﻘﻮﺓ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ ﻣﺜﻞ ﺍﻟﻤﺴﺪﺳﺎﺕ ﺍﻵﻟﻴﺔ ﻭﺍﻟﻤﺴﺪﺳﺎﺕ ﺍﻟﺮﺷﺎﺷﺔ.</BlowbackOperation.description>
  <!-- EN:
    <li>subject->pistols</li>
    <li>subject->blowback firearms</li>
    <li>subject_story->utilized machine pistols in the trench fighting that overtook the planet</li>
    <li>subject_story->sold low-powered autopistols to law enforcement in the orbitals</li>
    <li>subject_story->crafted blowback-operated guns for near-sighted conscripts</li>
    <li>subject_gerund->crafting blowback firearms</li>
  -->
  <BlowbackOperation.generalRules.rulesStrings>
    <li>subject->ﻣﺴﺪﺳﺎﺕ</li>
    <li>subject_FemMas->ﺍﻟﻤﺴﺪﺳﺎﺕ</li>
    <li>subject->ﺃﺳﻠﺤﺔ ﻧﺎﺭﻳﺔ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ</li>
    <li>subject_FemMas->ﺍﻷﺳﻠﺤﺔ ﺍﻟﻨﺎﺭﻳﺔ ﺍﻟﺘﻲ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ</li>
    <li>subject_def->ﻟﻠﻤﺴﺪﺳﺎﺕ</li>
    <li>subject_def2->ﺇﻟﻰ ﺍﻟﻤﺴﺪﺳﺎﺕ</li>
    <li>subject_def->ﻟﻷﺴﻠﺤﺔ ﺍﻟﻨﺎﺭﻳﺔ ﺍﻟﺘﻲ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ</li>
    <li>subject_def2->ﺇﻟﻰ ﺍﻷﺳﻠﺤﺔ ﺍﻟﻨﺎﺭﻳﺔ ﺍﻟﺘﻲ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ</li>
    <li>subject_story->ﺍﺳﺘﺨﺪﻡ ﻣﺴﺪﺳﺎﺕ ﺭﺷﺎﺷﺔ ﻓﻲ ﻗﺘﺎﻝ ﺍﻟﺨﻨﺎﺩﻕ ﺍﻟﺬﻱ ﺍﺟﺘﺎﺡ ﺍﻟﻜﻮﻛﺐ</li>
    <li>subject_story->ﺑﺎﻉ ﻣﺴﺪﺳﺎﺕ ﺁﻟﻴﺔ ﻣﻨﺨﻔﻀﺔ ﺍﻟﻘﻮﺓ ﻟﺠﻬﺎﺕ ﺇﻧﻔﺎﺫ ﺍﻟﻘﺎﻧﻮﻥ ﻓﻲ ﺍﻟﻤﺴﺘﻌﻤﺮﺍﺕ ﺍﻟﻤﺪﺍﺭﻳﺔ</li>
    <li>subject_story->ﺻﻨﻊ ﺃﺳﻠﺤﺔ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ ﻟﻤﺠﻨﺪﻳﻦ ﻗﺼﻴﺮﻱ ﺍﻟﻨﻈﺮ</li>
    <li>subject_gerund->ﺻﻨﺎﻋﺔ ﺃﺳﻠﺤﺔ ﻧﺎﺭﻳﺔ ﺗﻌﻤﻞ ﺑﺎﻻﺭﺗﺪﺍﺩ</li>
  </BlowbackOperation.generalRules.rulesStrings>

  <!-- EN: advanced lights -->
  <ColoredLights.label>ﺇﺿﺎﺀﺓ ﻣﺘﻘﺪﻣﺔ</ColoredLights.label>
  <!-- EN: Build powerful outdoors lights. Additionally, customize the color of electric lights and reduce their power consumption by half. This does not affect sun lamps. -->
  <ColoredLights.description>ﺍﺑﻦِ ﺃﺿﻮﺍﺀ ﺧﺎﺭﺟﻴﺔ ﻗﻮﻳﺔ. ﺑﺎﻹﺿﺎﻓﺔ ﺇﻟﻰ ﺫﻟﻚ، ﺧﺼّﺺ ﻟﻮﻥ ﺍﻷﺿﻮﺍﺀ ﺍﻟﻜﻬﺮﺑﺎﺋﻴﺔ ﻭﺧﻔّﺾ ﺍﺳﺘﻬﻻﻜﻬﺎ ﻟﻠﻄﺎﻗﺔ ﺇﻟﻰ ﺍﻟﻨﺼﻒ. ﻫﺬﺍ ﻻ ﻳﺆﺛﺮ ﻋﻠﻰ ﻣﺼﺎﺑﻴﺢ ﺍﻟﺸﻤﺲ.</ColoredLights.description>
  <!-- EN:
    <li>subject->advanced lighting</li>
    <li>subject_story->installed floodlights all around the prison world's many security perimeters</li>
    <li>subject_story->made sure that the planet's dark side was well-lit</li>
    <li>subject_story->moved into running concerts for interstellar troubadours, specializing in controlling the ship's massive lighting rigs</li>
    <li>subject_gerund->building advanced lights</li>
  -->
  <ColoredLights.generalRules.rulesStrings>
    <li>subject->ﺇﺿﺎﺀﺓ ﻣﺘﻘﺪﻣﺔ</li>
    <li>subject_FemMas->ﺍﻹﺿﺎﺀﺓ ﺍﻟﻤﺘﻘﺪﻣﺔ</li>
    <li>subject_def->ﻟﻹﻀﺎﺀﺓ ﺍﻟﻤﺘﻘﺪﻣﺔ</li>
    <li>subject_def2->ﺇﻟﻰ ﺍﻹﺿﺎﺀﺓ ﺍﻟﻤﺘﻘﺪﻣﺔ</li>
    <li>subject_story->ﺭﻛّﺐ ﻛﺸﺎﻓﺎﺕ ﺣﻮﻝ ﻣﺤﻴﻄﺎﺕ ﺍﻷﻣﻦ ﺍﻟﻌﺪﻳﺪﺓ ﻓﻲ ﻋﺎﻟﻢ ﺍﻟﺴﺠﻦ</li>
    <li>subject_story->ﺗﺄﻛﺪ ﻣﻦ ﺃﻥ ﺍﻟﺠﺎﻧﺐ ﺍﻟﻤﻈﻠﻢ ﻣﻦ ﺍﻟﻜﻮﻛﺐ ﻣُﻀﺎﺀ ﺟﻴﺪًﺍ</li>
    <li>subject_story->ﺍﺗﺠﻪ ﺇﻟﻰ ﺗﻨﻈﻴﻢ ﺣﻔﻻﺖ ﻟﺘﺮﻭﺑﺎﺩﻭﺭﺍﺕ ﺑﻴﻦ ﻧﺠﻤﻴﺔ، ﻣﺘﺨﺼّﺼًﺎ ﻓﻲ ﺍﻟﺘﺤﻜﻢ ﺑﻤﻨﺼﺎﺕ ﺍﻹﺿﺎﺀﺓ ﺍﻟﻀﺨﻤﺔ ﻟﻠﺴﻔﻴﻨﺔ</li>
    <li>subject_gerund->ﺑﻨﺎﺀ ﺃﺿﻮﺍﺀ ﻣﺘﻘﺪﻣﺔ</li>
  </ColoredLights.generalRules.rulesStrings>

  <!-- EN: electricity -->
  <Electricity.label>ﻛﻬﺮﺑﺎﺀ</Electricity.label>
  <!-- EN: Harness the power of electricity for a hundred different tasks. -->
  <Electricity.description>ﺍﻟﻤﺨﺘﻠﻔﺔ ﺍﻟﻤﻬﺎﻡ ﻟﻤﺌﺎﺕ ﺍﻟﻜﻬﺮﺑﺎﺀ ﻗﻮﺓ ﺳﺨّﺮ.</Electricity.description>
  <!-- EN: Your colony has harnessed the power which outsiders call "electricity". It has the potential to transform every aspect of your people's way of life.\n\nYou have now unlocked the Power tab in the Architect menu from which you may build electric generators, power conduits, and other mechanisms to control this new force. The Power tab also displays the electric grid which connects electric generators and appliances. -->
  <Electricity.discoveredLetterText>ﺑﺎﻷﺟﻬﺰﺓ ﺍﻟﻜﻬﺮﺑﺎﺋﻴﺔ ﺍﻟﻤﻮﻟﺪﺍﺕ ﺗﺮﺑﻂ ﺍﻟﺘﻲ ﺍﻟﻜﻬﺮﺑﺎﺋﻴﺔ ﺍﻟﺸﺒﻜﺔ «ﺃﻳﻀﺎً». ﺍﻟﻄﺎﻗﺔ ﺗﺒﻮﻳﺐ ﻳﻌﺮﺽ ﺍﻟﺠﺪﻳﺪﺓ ﺍﻟﻘﻮﺓ ﺑﻬﺬﻩ ﻟﻠﺘﺤﻜﻢ ﺃﺧﺮﻯ ﻭﺁﻟﻴﺎﺕ ﻛﻬﺮﺑﺎﺋﻴﺔ،.\n\nﻭﻣﻮﺻﻻﺖ ﻛﻬﺮﺑﺎﺋﻴﺔ، ﻣﻮﻟﺪﺍﺕ ﺑﻨﺎﺀ ﺧﻠﻪ ﻣﻦ ﻳﻤﻜﻨﻚ ﻭﺍﻟﺬﻱ ﺍﻟﻤﻌﻤﺎﺭﻱ، ﺍﻟﻤﻬﻨﺪﺱ ﻗﺎﺋﻤﺔ ﻓﻲ ﺍﻟﻄﺎﻗﺔ ﺗﺒﻮﻳﺐ ﺍﻵﻥ ﻓﺘﺤﺖ ﻟﻘﺪ ﺷﻌﺒﻚ ﺣﻴﺎﺓ ﺃﺳﻠﻮﺏ ﻣﻦ ﺟﺎﻧﺐ ﻛﻞ ﺗﺤﻮﻳﻞ. ﻋﻠﻰ ﺍﻟﻘﺪﺭﺓ ﻟﺪﻳﻬﺎ ﺍﻟﻜﻬﺮﺑﺎﺀ ﺍﻟﻐﺮﺑﺎﺀ ﻳﺴﻤﻴﻬﺎ ﺍﻟﺘﻲ ﺍﻟﻘﻮﺓ ﻣﺴﺘﻌﻤﺮﺗﻚ ﺳﺨّﺮﺕ ﻟﻘﺪ.</Electricity.discoveredLetterText>
  <!-- EN: About: Electricity -->
  <Electricity.discoveredLetterTitle>ﺍﻟﻜﻬﺮﺑﺎﺀ: ﺣﻮﻝ</Electricity.discoveredLetterTitle>
  <!-- EN:
    <li>subject->electricity</li>
    <li>subject_story->was struck by lighting and became determined to harness it</li>
    <li>subject_story->created the first generator and lightbulb on a medieval world</li>
    <li>subject_story->was executed on a feudal world for the blasphemy of creating light</li>
    <li>subject_gerund->harnessing electricity</li>
  -->
  <Electricity.generalRules.rulesStrings>
