<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- EN: air conditioning -->
  <AirConditioning.label>ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</AirConditioning.label>
  <!-- EN: Build coolers to make people comfortable in hot weather, or to construct freezers for storing perishable goods. -->
  <AirConditioning.description>ﺍﺑﻦِ ﺍﻟﻤﺒﺮّﺩﺍﺕ ﻟﺠﻌﻞ ﺍﻟﻨﺎﺱ ﻣﺮﺗﺎﺣﻴﻦ ﻓﻲ ﺍﻟﻄﻘﺲ ﺍﻟﺤﺎﺭ، ﺃﻭ ﺍﺑﻦِ ﺍﻟﻤﺠﻤّﺪﺍﺕ ﻟﺘﺨﺰﻳﻦ ﺍﻟﺒﻀﺎﺋﻊ ﺍﻟﻘﺎﺑﻠﺔ ﻟﻠﺘﻠﻒ.</AirConditioning.description>
  <!-- EN:
    <li>subject->air conditioning</li>
    <li>subject_story->visited the hottest town on the planet</li>
    <li>subject_story->worked at the ice caps, in an interstellar warehouse kept near to absolute zero</li>
    <li>subject_story->learned all about air conditioning and freezers, then returned home</li>
    <li>subject_gerund->building air conditioning units</li>
  -->
  <AirConditioning.generalRules.rulesStrings>
    <li>subject->ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</li>
    <li>subject_FemMas->ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</li>
    <li>subject_def->ﻟﺘﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</li>
    <li>subject_def2->ﺇﻟﻰ ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</li>
    <li>subject_story->ﺯﺍﺭ ﺃﻛﺜﺮ ﺑﻠﺪﺓ ﺣﺮﺍﺭﺓ ﻋﻠﻰ ﺍﻟﻜﻮﻛﺐ</li>
    <li>subject_story->ﻋﻤﻞ ﻋﻨﺪ ﺍﻟﻘﻤﻢ ﺍﻟﺠﻠﻴﺪﻳﺔ، ﻓﻲ ﻣﺴﺘﻮﺩﻉ ﺑﻴﻦ ﻧﺠﻤﻲ ﻣُﺤﺎﻓَﻆ ﻋﻠﻴﻪ ﻗﺮﺏ ﺍﻟﺼﻔﺮ ﺍﻟﻤﻄﻠﻖ</li>
    <li>subject_story->ﺗﻌﻠّﻢ ﻛﻞ ﺷﻲﺀ ﻋﻦ ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ ﻭﺍﻟﻤﺠﻤّﺪﺍﺕ، ﺛﻢ ﻋﺎﺩ ﺇﻟﻰ ﺍﻟﻮﻃﻦ</li>
    <li>subject_gerund->ﺑﻨﺎﺀ ﻭﺣﺪﺍﺕ ﺗﻜﻴﻴﻒ ﺍﻟﻬﻮﺍﺀ</li>
  </AirConditioning.generalRules.rulesStrings>

  <!-- EN: autodoor -->
  <Autodoors.label>ﺃﺑﻮﺍﺏ ﺁﻟﻴﺔ</Autodoors.label>
  <!-- EN: Build autodoors which automatically open when someone approaches, without slowing anyone down. -->
  <Autodoors.description>ﺍﺑﻦِ ﺃﺑﻮﺍﺑًﺎ ﺁﻟﻴﺔ ﺗُﻔﺘﺢ ﺗﻠﻘﺎﺋﻴًﺎ ﻋﻨﺪ ﺍﻗﺘﺮﺍﺏ ﺃﺣﺪ، ﺩﻭﻥ ﺇﺑﻄﺎﺀ ﺃﻱ ﺷﺨﺺ.</Autodoors.description>
  <!-- EN:
    <li>subject->autodoors</li>
    <li>subject->automatic doors</li>
    <li>subject_story->was recruited by a robotics security firm, opening the door to a career as an automation tester</li>
    <li>subject_story->prototyped unique models of autodoors</li>
    <li>subject_story->worked very hard to ensure the doors made a satisfying 'hiss' when they opened or closed</li>
    <li>subject_gerund->constructing autodoors</li>
  -->
  <Autodoors.generalRules.rulesStrings>
    <li>subject->ﺃﺑﻮﺍﺏ ﺁﻟﻴﺔ</li>
    <li>subject_FemMas->ﺍﻷﺑﻮﺍﺏ ﺍﻵﻟﻴﺔ</li>
    <li>subject_def->ﻟﻷﺒﻮﺍﺏ ﺍﻵﻟﻴﺔ</li>
    <li>subject_def2->ﺇﻟﻰ ﺍﻷﺑﻮﺍﺏ ﺍﻵﻟﻴﺔ</li>
    <li>subject_story->ﺟُﻨِّﺪ ﻣﻦ ﻗِﺒﻞ ﺷﺮﻛﺔ ﺃﻣﻦ ﺭﻭﺑﻮﺗﻴﺔ، ﻓﺎﺗﺤًﺎ ﺍﻟﺒﺎﺏ ﻟﻤﺴﻴﺮﺓ ﻣﻬﻨﻴﺔ ﻛﻤﺨﺘﺒِﺮ ﺃﺗﻤﺘﺔ</li>
    <li>subject_story->ﻃﻮّﺭ ﻧﻤﺎﺫﺝ ﺃﻭﻟﻴﺔ ﻓﺮﻳﺪﺓ ﻣﻦ ﺍﻷﺑﻮﺍﺏ ﺍﻵﻟﻴﺔ</li>
    <li>subject_story->ﻋﻤﻞ ﺑﺠﺪ ﺷﺪﻳﺪ ﻟﻀﻤﺎﻥ ﺃﻥ ﺗُﺼﺪﺭ ﺍﻷﺑﻮﺍﺏ «ﻫﺴﻴﺴًﺎ» ﻣُﺮﺿﻴًﺎ ﻋﻨﺪ ﻓﺘﺤﻬﺎ ﺃﻭ ﺇﻏﻻﻘﻬﺎ</li>
    <li>subject_gerund->ﺑﻨﺎﺀ ﺃﺑﻮﺍﺏ ﺁﻟﻴﺔ</li>
  </Autodoors.generalRules.rulesStrings>

  <!-- EN: battery -->
  <Batteries.label>ﺑﻄﺎﺭﻳﺎﺕ</Batteries.label>
  <!-- EN: Build batteries for storing electricity. -->
  <Batteries.description>ﺍﺑﻦِ ﺑﻄﺎﺭﻳﺎﺕ ﻟﺘﺨﺰﻳﻦ ﺍﻟﻜﻬﺮﺑﺎﺀ.</Batteries.description>
