    <li>subject_gerund->ﺍﻟﻤﻜﺎﻓﺄﺓ ﺇﺷﺎﺭﺍﺕ ﺃﻧﻈﻤﺔ ﺑﻨﺎﺀ</li>
  </ShipComputerCore.generalRules.rulesStrings>
  
  <!-- EN: vacuum cryptosleep casket -->
  <ShipCryptosleep.label>ﻟﻠﻔﺮﺍﻍ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﺎﺑﻮﺕ</ShipCryptosleep.label>
  <!-- EN: Construct hardened cryptosleep caskets tough enough to be exposed to vacuum, for transporting people on the years-long journey between stars. -->
  <ShipCryptosleep.description>ﻟﺴﻨﻮﺍﺕ ﺗﻤﺘﺪ ﺍﻟﺘﻲ ﺍﻟﻨﺠﻮﻡ ﺑﻴﻦ ﺍﻟﺮﺣﻠﺔ ﻓﻲ ﺍﻟﻨﺎﺱ ﻟﻨﻘﻞ ﻟﻠﻔﺮﺍﻍ، ﻟﺘﺘﻌﺮﺽ ﻳﻜﻔﻲ ﺑﻤﺎ ﻣُﻘﺴﺎﺓ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﻮﺍﺑﻴﺖ ﺷﻴّﺪ.</ShipCryptosleep.description>
  <!-- EN:
    <li>subject->starship-grade cryptosleep caskets</li>
    <li>subject_story->replaced the failed cryptosleep caskets on the CMC Celeste, so the old generation ship could be used again</li>
    <li>subject_story->was accidentally ejected in deep space, surviving in a self-designed casket for two months</li>
    <li>subject_story->lectured on the differences between planetary- and starship-grade equipment</li>
    <li>subject_gerund->constructing hardened cryptosleep caskets</li>
  -->
  <ShipCryptosleep.generalRules.rulesStrings>
    <li>subject->ﻧﺠﻤﻴﺔ ﺳﻔﻴﻨﺔ ﺑﻤﺴﺘﻮﻯ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﻮﺍﺑﻴﺖ</li>
    <li>subject_FemMas->ﻧﺠﻤﻴﺔ ﺳﻔﻴﻨﺔ ﺑﻤﺴﺘﻮﻯ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﻮﺍﺑﻴﺖ</li>
    <li>subject_def->ﻧﺠﻤﻴﺔ ﺳﻔﻴﻨﺔ ﺑﻤﺴﺘﻮﻯ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﻟﺘﻮﺍﺑﻴﺖ</li>
    <li>subject_def2->ﻧﺠﻤﻴﺔ ﺳﻔﻴﻨﺔ ﺑﻤﺴﺘﻮﻯ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﻮﺍﺑﻴﺖ ﺇﻟﻰ</li>
    <li>subject_story->ﻣﺠﺪﺩًﺍ ﺍﻟﻘﺪﻳﻤﺔ ﺍﻷﺟﻴﺎﻝ ﺳﻔﻴﻨﺔ ﺍﺳﺘﺨﺪﺍﻡ ﻳﻤﻜﻦ ﻟﻜﻲ CMC Celeste، ﻣﺘﻦ ﻋﻠﻰ ﺍﻟﻤﻌﻄﻠﺔ ﺍﻟﻤُﺸﻔّﺮ ﺍﻟﺴﺒﺎﺕ ﺗﻮﺍﺑﻴﺖ ﺍﺳﺘﺒﺪﻝ</li>
    <li>subject_story->ﺷﻬﺮﻳﻦ ﻟﻤﺪﺓ ﺑﻨﻔﺴﻪ ﺻﻤﻤﻪ ﺗﺎﺑﻮﺕ ﺩﺍﺧﻞ ﻭﻧﺠﺎ ﺍﻟﺴﺤﻴﻖ، ﺍﻟﻔﻀﺎﺀ ﺇﻟﻰ ﺑﺎﻟﺨﻄﺄ ﻗُﺬﻑ</li>
    <li>subject_story->ﺍﻟﻨﺠﻤﻴﺔ ﺍﻟﺴﻔﻦ ﻣﺴﺘﻮﻯ ﻭﻣﻌﺪﺍﺕ ﺍﻟﻜﻮﻛﺒﻲ ﺍﻟﻤﺴﺘﻮﻯ ﻣﻌﺪﺍﺕ ﺑﻴﻦ ﺍﻟﻔﺮﻭﻕ ﻋﻦ ﻣﺤﺎﺿﺮﺓ ﺃﻟﻘﻰ</li>
    <li>subject_gerund->ﻣُﻘﺴﺎﺓ ﻣُﺸﻔّﺮ ﺳﺒﺎﺕٍ ﺗﻮﺍﺑﻴﺖ ﺑﻨﺎﺀ</li>
  </ShipCryptosleep.generalRules.rulesStrings>
  
  <!-- EN: Johnson-Tanaka drive -->
  <ShipEngine.label>ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ-ﻣﺤﺮﻙ</ShipEngine.label>
  <!-- EN: Construct a Johnson-Tanaka drive for a ship. The JT drive can push you to other stars by leveraging quantum scale effects to beam momentum to distant stars. Of course, as with all starships, it still takes many years to get anywhere. -->
  <ShipEngine.description>ﻋﺪﻳﺪﺓ ﺳﻨﻮﺍﺕ ﻳﺴﺘﻐﺮﻕ-ﻣﻜﺎﻥ ﺃﻱ. ﺇﻟﻰ ﺍﻟﻮﺻﻮﻝ JT ﺯﺍﻝ ﻣﺎ ﺍﻟﻨﺠﻤﻴﺔ، ﺍﻟﺴﻔﻦ ﺟﻤﻴﻊ ﻣﻊ ﺍﻟﺤﺎﻝ ﻫﻮ ﻛﻤﺎ ﻭﺑﺎﻟﻄﺒﻊ، ﺑﻌﻴﺪﺓ ﻧﺠﻮﻡ ﺇﻟﻰ ﺍﻟﺰﺧﻢ. ﻟﺒﺚ ﺍﻟﻜﻤﻲ ﺍﻟﻤﻘﻴﺎﺱ ﺗﺄﺛﻴﺮﺍﺕ ﺗﺴﺨﻴﺮ ﻋﺒﺮ ﺃﺧﺮﻯ ﻧﺠﻮﻡ ﺇﻟﻰ ﺩﻓﻌﻚ ﻟﻤﺤﺮﻙ ﻳﻤﻜﻦ ﻟﺴﻔﻴﻨﺔ ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ ﻣﺤﺮﻙ ﺷﻴّﺪ.</ShipEngine.description>
  <!-- EN:
    <li>subject->Johnson-Tanaka theory</li>
    <li>subject->exotic momentum transfer</li>
    <li>subject_story->lectured in the university on Johnson, Tanaka and quantum-scale effects</li>
    <li>subject_story->constructed a Johnson-Tanaka drive from first principles for a thesis</li>
    <li>subject_story->maintained a Johnson-Tanaka drive for two decades, as the ship traveled between the stars</li>
    <li>subject_gerund->constructing starship drives</li>
  -->
  <ShipEngine.generalRules.rulesStrings>
    <li>subject->ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ-ﻧﻈﺮﻳﺔ</li>
    <li>subject_FemMas->ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ-ﻧﻈﺮﻳﺔ</li>
    <li>subject->ﻏﺮﻳﺐ ﺯﺧﻢ ﻧﻘﻞ</li>
    <li>subject_FemMas->ﻏﺮﻳﺐ ﺯﺧﻢ ﻧﻘﻞ</li>
    <li>subject_def->ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ-ﻟﻨﻈﺮﻳﺔ</li>
    <li>subject_def2->ﺗﺎﻧﺎﻛﺎ ﺟﻮﻧﺴﻮﻥ ﻧﻈﺮﻳﺔ-ﺇﻟﻰ</li>
