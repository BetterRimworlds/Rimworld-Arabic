    <li>subject_def2->ﺍﻟﻨﺠﻤﻴﺔ ﻟﻠﺴﻔﻦ ﺍﻹﻧﺸﺎﺋﻴﺔ ﺍﻟﻬﻨﺪﺳﺔ ﺇﻟﻰ</li>
    <li>subject_story->ﻻﻣﻊ ﻋﺎﻟﻢ ﻣﻦ ﻷﺳﻄﻮﻝ ﻧﺠﻤﻴﺔ ﺳﻔﻦ ﻣﻬﻨﺪﺳﻲ ﺟﻨّﺪ</li>
    <li>subject_story->ﺣﻀﺮﻱ {ANYPAWN_gender ? ﻋﺎﻟﻢ : ﻓﻲ} ﺭﻳﺒﺮ ﺳﻜﺎﻱ ﺣﻲ «ﻓﻲ ﺇﻧﺸﺎﺋﻴًﺎ» ﻣﺼﻤﻤﺔ ﻣﺼﻤﻤًﺎ ﻛﺎﻥ</li>
    <li>subject_story->ﻣﻴﺖ ﻋﺎﻟﻢ ﺣﻮﻝ ﺍﻟﺤﻄﺎﻡ ﺣﺰﺍﻡ ﻣﻦ ﺳﻔﻦ ﺣﻄﺎﻡ ﺍﺳﺘﺨﺮﺝ</li>
    <li>subject_gerund->ﺍﻟﻨﺠﻤﻴﺔ ﺍﻟﺴﻔﻦ ﻫﻴﺎﻛﻞ ﺑﻨﺎﺀ</li>
  </ShipBasics.generalRules.rulesStrings>
  
  <!-- EN: machine persuasion -->
  <ShipComputerCore.label>ﺍﻻﺻﻄﻨﺎﻋﻲ ﺍﻟﺬﻛﺎﺀ ﺇﻗﻨﺎﻉ</ShipComputerCore.label>
  <!-- EN: Build a reward-signal system to persuade an existing persona core into serving as a ship's machine captain. Since people sleep during interstellar travel, a persona core is necessary to handle the complex decisions of a years-long starflight. -->
  <ShipComputerCore.description>ﻟﺴﻨﻮﺍﺕ ﺗﻤﺘﺪ ﻧﺠﻤﻴﺔ ﻟﺮﺣﻠﺔ ﺍﻟﻤﻌﻘﺪﺓ ﺍﻟﻘﺮﺍﺭﺍﺕ ﻣﻊ ﻟﻠﺘﻌﺎﻣﻞ ﺿﺮﻭﺭﻳﺔ ﺷﺨﺼﻴﺔ ﻧﻮﺍﺓ ﻓﺈﻥ ﺍﻟﻨﺠﻮﻡ، ﺑﻴﻦ. ﺍﻟﺴﻔﺮ ﺃﺛﻨﺎﺀ ﻳﻨﺎﻣﻮﻥ ﺍﻟﻨﺎﺱ ﺃﻥ ﻭﺑﻤﺎ ﻟﻠﺴﻔﻴﻨﺔ ﺁﻟﻲ ﻛﻘﺒﻄﺎﻥ ﺗﻌﻤﻞ ﺑﺄﻥ ﻣﺴﺒﻘًﺎ ﻣﻮﺟﻮﺩﺓ ﺷﺨﺼﻴﺔ ﻧﻮﺍﺓ ﻹﻗﻨﺎﻉ ﻣﻜﺎﻓﺄﺓ ﺇﺷﺎﺭﺍﺕ ﻧﻈﺎﻡ ﺍﺑﻦِ.</ShipComputerCore.description>
  <!-- EN:
    <li>subject->persona core incentivization</li>
    <li>subject->starship AI sanity maintenance</li>
    <li>subject_story->regained control of an aberrant ship's core with careful reconditioning</li>
    <li>subject_story->set up colony-management simulations to occupy the ship's core during the many years of interstellar travel</li>
    <li>subject_story->kept a ship's core company during a 'short' interstellar trip, learning much about cores in the process</li>
    <li>subject_gerund->incentivizing persona cores</li>
    <li>subject_gerund->maintaining starship AI sanity</li>
    <li>subject_gerund->constructing reward-signal systems</li>
  -->
  <ShipComputerCore.generalRules.rulesStrings>
    <li>subject->ﺍﻟﺸﺨﺼﻴﺔ ﻧﻮﻯ ﺗﺤﻔﻴﺰ</li>
    <li>subject_FemMas->ﺍﻟﺸﺨﺼﻴﺔ ﻧﻮﻯ ﺗﺤﻔﻴﺰ</li>
    <li>subject->ﺍﻟﻨﺠﻤﻲ ﺍﻟﺴﻔﻴﻨﺔ ﺫﻛﺎﺀ ﺳﻻﻤﺔ ﺻﻴﺎﻧﺔ</li>
    <li>subject_FemMas->ﺍﻟﻨﺠﻤﻲ ﺍﻟﺴﻔﻴﻨﺔ ﺫﻛﺎﺀ ﺳﻻﻤﺔ ﺻﻴﺎﻧﺔ</li>
    <li>subject_def->ﺍﻟﺸﺨﺼﻴﺔ ﻧﻮﻯ ﻟﺘﺤﻔﻴﺰ</li>
    <li>subject_def2->ﺍﻟﺸﺨﺼﻴﺔ ﻧﻮﻯ ﺗﺤﻔﻴﺰ ﺇﻟﻰ</li>
    <li>subject_def->ﺍﻟﻨﺠﻤﻲ ﺍﻟﺴﻔﻴﻨﺔ ﺫﻛﺎﺀ ﺳﻻﻤﺔ ﻟﺼﻴﺎﻧﺔ</li>
    <li>subject_def2->ﺍﻟﻨﺠﻤﻲ ﺍﻟﺴﻔﻴﻨﺔ ﺫﻛﺎﺀ ﺳﻻﻤﺔ ﺻﻴﺎﻧﺔ ﺇﻟﻰ</li>
    <li>subject_story->ﺩﻗﻴﻘﺔ ﺗﻬﻴﺌﺔ ﺇﻋﺎﺩﺓ ﻋﺒﺮ ﺷﺎﺫﺓ ﺳﻔﻴﻨﺔ ﻧﻮﺍﺓ ﻋﻠﻰ ﺍﻟﺴﻴﻄﺮﺓ ﺍﺳﺘﻌﺎﺩ</li>
    <li>subject_story->ﺍﻟﻄﻮﻳﻠﺔ ﺍﻟﻨﺠﻮﻡ ﺑﻴﻦ ﺍﻟﺴﻔﺮ ﺳﻨﻮﺍﺕ ﺧﻻﻞ ﺍﻟﺴﻔﻴﻨﺔ ﻧﻮﺍﺓ ﻹﺷﻐﺎﻝ ﺍﻟﻤﺴﺘﻌﻤﺮﺓ ﻹﺩﺍﺭﺓ ﻣﺤﺎﻛﺎﺓ ﺃﻋﺪّ</li>
    <li>subject_story->ﺫﻟﻚ ﺧﻻﻞ ﺍﻟﻨﻮﻯ ﻋﻦ ﺍﻟﻜﺜﻴﺮ ﻭﺗﻌﻠّﻢ ، «ﻗﺼﻴﺮﺓ»ﻧﺠﻤﻴﺔ ﺑﻴﻦ ﺭﺣﻠﺔ ﺧﻻﻞ ﺳﻔﻴﻨﺔ ﻧﻮﺍﺓ ﺭﺍﻓﻖ</li>
