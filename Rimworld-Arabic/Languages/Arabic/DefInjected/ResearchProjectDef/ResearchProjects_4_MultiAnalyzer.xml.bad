    <li>subject_def->ﺍﻟﻘﻨّﺎﺻﺔ ﺃﺑﺮﺍﺝ</li>
    <li>subject_def2->ﺍﻟﻘﻨّﺎﺻﺔ ﺃﺑﺮﺍﺝ</li>
    <li>subject_story->ﺍﻟﺠﺒﻬﺔ ﺧﻂ ﻣﻦ ﻣﺴﺘﻬﻠﻜﺔ ﻣﺸﻌّﺔ ﻳﻮﺭﺍﻧﻴﻮﻡ ﻣﻘﺬﻭﻓﺎﺕ ﺟﺎﻣﻌًﺎ ﺍﻟﺤﺮﺏ، ﺑﻌﺪ ﺍﻟﺘﻨﻈﻴﻒ ﺃﻋﻤﺎﻝ ﻗﺎﺩ</li>
    <li>subject_story->ﺍﻟﻜﻴﻔﻴﺔ ﻓﻬﻢ ﺇﻟﻰ ﻭﺍﺣﺘﺎﺝ ﻣﺒﺎﺷﺮﺓً ﻫﺠﻮﻣﻲ ﻣﻴﻜﺎﻧﻮﻳﺪ ﻋﺒﺮ ﻳﻄﻠﻖ ﺑﺮﺟًﺎ ﺭﺃﻯ</li>
    <li>subject_story->ﺍﻟﺪﺭﻭﻉ ﻋﻠﻰ ﺍﻟﺬﺧﻴﺮﺓ ﻛﺜﺎﻓﺔ ﺗﺄﺛﻴﺮ ﺑﺤﺚ</li>
    <li>subject_gerund->ﻗﻨّﺎﺻﺔ ﺃﺑﺮﺍﺝ ﺑﻨﺎﺀ</li>
  </SniperTurret.generalRules.rulesStrings>
  
  <!-- EN: vitals monitor -->
  <VitalsMonitor.label>ﺍﻟﺤﻴﻮﻳﺔ ﺍﻟﻌﻻﻤﺎﺕ ﻣﺮﺍﻗﺐ</VitalsMonitor.label>
  <!-- EN: Build vitals monitors which improve medical outcomes when placed next to hospital beds. -->
  <VitalsMonitor.description>ﺍﻟﻤﺴﺘﺸﻔﻰ ﺃﺳﺮّﺓ ﺑﺠﻮﺍﺭ ﻭﺿﻌﻬﺎ ﻋﻨﺪ ﺍﻟﻄﺒﻴﺔ ﺍﻟﻨﺘﺎﺋﺞ ﺗﺤﺴّﻦ ﺍﻟﺘﻲ ﺍﻟﺤﻴﻮﻳﺔ ﺍﻟﻌﻻﻤﺎﺕ ﻣﺮﺍﻗﺒﺎﺕ ﺍﺑﻦِ.</VitalsMonitor.description>
  <!-- EN:
    <li>subject->vital signs monitoring</li>
    <li>subject_story->struggled in an overcrowded hospital and vowed to work for change</li>
    <li>subject_story->nursed a glassworld survivor back to health</li>
    <li>subject_story->monitored the isolation ward remotely, sending mechanoids in for treatments</li>
    <li>subject_gerund->monitoring vital signs</li>
    <li>subject_gerund->constructing vital signs monitors</li>
  -->
  <VitalsMonitor.generalRules.rulesStrings>
    <li>subject->ﺍﻟﺤﻴﻮﻳﺔ ﺍﻟﻌﻻﻤﺎﺕ ﻣﺮﺍﻗﺒﺔ</li>
    <li>subject_FemMas->ﺍﻟﺤﻴﻮﻳﺔ ﺍﻟﻌﻻﻤﺎﺕ ﻣﺮﺍﻗﺒﺔ</li>
