<LanguageData>
  
  <!-- EN: advanced fabrication -->
  <AdvancedFabrication.label>ﺍﻟﻤﺘﻘﺪﻡ ﺍﻟﺘﺼﻨﻴﻊ</AdvancedFabrication.label>
  <!-- EN: Fabricate advanced components from standard components and other materials. -->
  <AdvancedFabrication.description>ﺃﺧﺮﻯ ﻭﻣﻮﺍﺩ ﻗﻴﺎﺳﻴﺔ ﻣﻜﻮّﻧﺎﺕ ﻣﻦ ﺍﻧﻄﻻﻘًﺎ ﻣﺘﻘﺪﻣﺔ ﻣﻜﻮّﻧﺎﺕ ﺻﻨّﻊ.</AdvancedFabrication.description>
  <!-- EN:
    <li>subject->advanced component fabrication</li>
    <li>subject_story->traded advanced components to desperate rimworlders</li>
    <li>subject_story->learned the secrets of fabricating advanced components and died without revealing them</li>
    <li>subject_story->balked at the extreme cost of crafting advanced components and chose a simpler lifestyle</li>
    <li>subject_gerund->fabricating advanced components</li>
  -->
  <AdvancedFabrication.generalRules.rulesStrings>
    <li>subject->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ</li>
    <li>subject_FemMas->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ</li>
    <li>subject_def->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ</li>
    <li>subject_def2->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ</li>
    <li>subject_story->ﺍﻟﻴﺎﺋﺴﻴﻦ ﺍﻟﺤﺎﻓﺔ ﺳﻜﺎﻥ ﻣﻊ ﻣﺘﻘﺪﻣﺔ ﺑﻤﻜﻮّﻧﺎﺕ ﺗﺎﺟﺮ</li>
    <li>subject_story->ﻳﻜﺸﻔﻬﺎ ﺃﻥ ﺩﻭﻥ ﻭﻣﺎﺕ ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ ﺃﺳﺮﺍﺭ ﺗﻌﻠّﻢ</li>
    <li>subject_story->ﺃﺑﺴﻂ ﺣﻴﺎﺓ ﺃﺳﻠﻮﺏ ﻭﺍﺧﺘﺎﺭ ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﻟﺼﻨﻊ ﺍﻟﺒﺎﻫﻈﺔ ﺍﻟﺘﻜﻠﻔﺔ ﺃﻣﺎﻡ ﺗﺮﺍﺟﻊ</li>
    <li>subject_gerund->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺼﻨﻴﻊ</li>
  </AdvancedFabrication.generalRules.rulesStrings>
  
  <!-- EN: bionic replacements -->
  <Bionics.label>ﺑﻴﻮﻧﻴﻜﻴﺔ ﺑﺪﺍﺋﻞ</Bionics.label>
  <!-- EN: Build high-tech bionic body parts to replace lost limbs and eyes. Requires a skilled doctor to attach. -->
  <Bionics.description>ﻣﺎﻫﺮًﺍ ﻃﺒﻴﺒًﺎ ﺗﺮﻛﻴﺒﻬﺎ ﻳﺘﻄﻠﺐ ﺍﻟﻤﻔﻘﻮﺩﺓ ﻭﺍﻟﻌﻴﻮﻥ ﺍﻷﻃﺮﺍﻑ ﻻﺳﺘﺒﺪﺍﻝ ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ. ﺑﻴﻮﻧﻴﻜﻴﺔ ﺟﺴﺪ ﺃﺟﺰﺍﺀ ﺍﺑﻦِ.</Bionics.description>
  <!-- EN:
    <li>subject->bionic prosthesis</li>
    <li>subject_story->worked primarily with disfigured soldiers, crafting bespoke bionic facial elements so they could return to their loved ones</li>
    <li>subject_story->studied slowed vids of human motion to better craft bionic prosthetics</li>
    <li>subject_story->was volunteered to have the various prototype bionics  implanted, ending up as more machine than man</li>
    <li>subject_gerund->constructing bionic prosthetics</li>
    <li>subject_gerund->utilizing bionic body parts</li>
  -->
  <Bionics.generalRules.rulesStrings>
    <li>subject->ﺑﻴﻮﻧﻴﻜﻴﺔ ﺻﻨﺎﻋﻴﺔ ﺃﻃﺮﺍﻑ</li>
    <li>subject_FemMas->ﺍﻟﺒﻴﻮﻧﻴﻜﻴﺔ ﺍﻟﺼﻨﺎﻋﻴﺔ ﺍﻷﻃﺮﺍﻑ</li>
    <li>subject_def->ﺍﻟﺒﻴﻮﻧﻴﻜﻴﺔ ﺍﻟﺼﻨﺎﻋﻴﺔ ﺍﻷﻃﺮﺍﻑ</li>
    <li>subject_def2->ﺍﻟﺒﻴﻮﻧﻴﻜﻴﺔ ﺍﻟﺼﻨﺎﻋﻴﺔ ﺍﻷﻃﺮﺍﻑ</li>
    <li>subject_story->ﺃﺣﺒّﺎﺋﻬﻢ ﺇﻟﻰ ﺍﻟﻌﻮﺩﺓ ﻣﻦ ﻳﺘﻤﻜﻨﻮﺍ ﻛﻲ ﻣﺨﺼّﺼﺔ ﺑﻴﻮﻧﻴﻜﻴﺔ ﻭﺟﻪ ﻋﻨﺎﺻﺮ ﻭﺻﻨﻊ ﻣﺸﻮّﻫﻴﻦ، ﺟﻨﻮﺩ ﻣﻊ ﺃﺳﺎﺳًﺎ ﻋﻤﻞ</li>
    <li>subject_story->ﺍﻟﺒﻴﻮﻧﻴﻜﻴﺔ ﺍﻟﺼﻨﺎﻋﻴﺔ ﺍﻷﻃﺮﺍﻑ ﺻﻨﻊ ﻟﻴُﺤﺴﻦ ﺍﻹﻧﺴﺎﻥ ﻟﺤﺮﻛﺔ ﺑﻄﻴﺌﺔ ﻣﻘﺎﻃﻊ ﺩﺭﺱ</li>
    <li>subject_story->ﺇﻧﺴﺎﻥ ﺇﻟﻰ ﻣﻨﻪ ﺁﻟﺔ ﺇﻟﻰ ﺃﻗﺮﺏ ﺍﻷﻣﺮ ﺑﻪ ﻭﺍﻧﺘﻬﻰ ﻣﺨﺘﻠﻔﺔ، ﺑﻴﻮﻧﻴﻜﻴﺔ ﺃﻭﻟﻴﺔ ﻧﻤﺎﺫﺝ ﻟﺰﺭﻉ ﺗﻄﻮّﻉ</li>
    <li>subject_gerund->ﺑﻴﻮﻧﻴﻜﻴﺔ ﺻﻨﺎﻋﻴﺔ ﺃﻃﺮﺍﻑ ﺻﻨﻊ</li>
    <li>subject_gerund->ﺑﻴﻮﻧﻴﻜﻴﺔ ﺟﺴﺪ ﺃﺟﺰﺍﺀ ﺍﺳﺘﺨﺪﺍﻡ</li>
  </Bionics.generalRules.rulesStrings>
  
  <!-- EN: pulse-charged munitions -->
  <ChargedShot.label>ﺑﺎﻟﻨﺒﺾ ﻣﺸﺤﻮﻧﺔ ﺫﺧﺎﺋﺮ</ChargedShot.label>
  <!-- EN: Build weapons which fire pulse-charged munitions for extra damage. Note that these also require advanced components. -->
  <ChargedShot.description>ﻣﺘﻘﺪﻣﺔ ﻣﻜﻮّﻧﺎﺕ ﺃﻳﻀًﺎ ﺗﺘﻄﻠﺐ ﻫﺬﻩ ﺃﻥ ﻻﺣﻆ ﺇﺿﺎﻓﻲ ﺿﺮﺭ. ﻹﺣﺪﺍﺙ ﺑﺎﻟﻨﺒﺾ ﻣﺸﺤﻮﻧﺔ ﺫﺧﺎﺋﺮ ﺗﻄﻠﻖ ﺃﺳﻠﺤﺔ ﺍﺑﻦِ.</ChargedShot.description>
  <!-- EN:
    <li>subject->pulse munitions</li>
    <li>subject_story->studied glitterworld monorails and modified the tech for weapons</li>
    <li>subject_story->killed a mechanical crawler by kiting it with a charge lance</li>
    <li>subject_story->learned how to imbue rifle ammunition with retained charge, heavily increasing its lethality</li>
    <li>subject_gerund->constructing pulse munitions</li>
    <li>subject_gerund->utilising pulse munitions</li>
  -->
  <ChargedShot.generalRules.rulesStrings>
    <li>subject->ﻧﺒﻀﻴﺔ ﺫﺧﺎﺋﺮ</li>
    <li>subject_FemMas->ﺍﻟﻨﺒﻀﻴﺔ ﺍﻟﺬﺧﺎﺋﺮ</li>
    <li>subject_def->ﺍﻟﻨﺒﻀﻴﺔ ﺍﻟﺬﺧﺎﺋﺮ</li>
    <li>subject_def2->ﺍﻟﻨﺒﻀﻴﺔ ﺍﻟﺬﺧﺎﺋﺮ</li>
    <li>subject_story->ﺍﻷﺳﻠﺤﺔ ﻟﺘﻨﺎﺳﺐ ﺍﻟﺘﻘﻨﻴﺔ ﻭﻋﺪّﻝ ﻻﻣﻊ ﻋﺎﻟﻢ ﻓﻲ ﺍﻟﻤﻮﻧﻮﺭﻳﻞ ﻗﻄﺎﺭﺍﺕ ﺩﺭﺱ</li>
    <li>subject_story->ﺷﺤﻦ ﺭﻣﺢ ﺑﺎﺳﺘﺨﺪﺍﻡ ﻣﺴﺎﻓﺔ ﻋﻠﻰ ﻭﺇﺑﻘﺎﺋﻪ ﺍﺳﺘﺪﺭﺍﺟﻪ ﻋﺒﺮ ﺁﻟﻴًﺎ ﺯﺍﺣﻔًﺎ ﻗﺘﻞ</li>
    <li>subject_story->ﻛﺒﻴﺮ ﺑﺸﻜﻞ ﻓﺘﻜﻬﺎ ﺯﺍﺩ ﻣﺎ ﺑﻬﺎ، ﻣﺤﺘﻔَﻆ ﺑﺸﺤﻨﺔ ﺍﻟﺒﻨﺎﺩﻕ ﺫﺧﻴﺮﺓ ﺇﺷﺒﺎﻉ ﻛﻴﻔﻴﺔ ﺗﻌﻠّﻢ</li>
    <li>subject_gerund->ﻧﺒﻀﻴﺔ ﺫﺧﺎﺋﺮ ﺻﻨﻊ</li>
    <li>subject_gerund->ﻧﺒﻀﻴﺔ ﺫﺧﺎﺋﺮ ﺍﺳﺘﺨﺪﺍﻡ</li>
  </ChargedShot.generalRules.rulesStrings>
  
  <!-- EN: cryptosleep casket -->
  <Cryptosleep.label>ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ ﺗﻮﺍﺑﻴﺖ</Cryptosleep.label>
  <!-- EN: Construct cryptosleep caskets, which can put living beings in a state of indefinite suspended animation. -->
  <Cryptosleep.description>ﺍﻟﻤﺪﺓ ﻣﺤﺪﺩﺓ ﻏﻴﺮ ﻣﻌﻠّﻖ ﺳﺒﺎﺕ ﺣﺎﻟﺔ ﻓﻲ ﺍﻟﺤﻴﺔ ﺍﻟﻜﺎﺋﻨﺎﺕ ﻭﺿﻊ ﻳﻤﻜﻨﻬﺎ ﻭﺍﻟﺘﻲ ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ، ﺍﻟﺴﺒﺎﺕ ﺗﻮﺍﺑﻴﺖ ﺍﺑﻦِ.</Cryptosleep.description>
  <!-- EN:
    <li>subject->cryptosleep</li>
    <li>subject_story->intended to test a prototype cryptosleep casket and woke a generation later, alone</li>
    <li>subject_story->sentenced the system's worst criminal to indefinite cryptosleep rather than death</li>
    <li>subject_story->used a cryptosleep capsule to suspend the terminally ill, so they could see their children once they'd grown up</li>
    <li>subject_gerund->constructing cryptosleep caskets</li>
    <li>subject_gerund->inducing cryptosleep</li>
  -->
  <Cryptosleep.generalRules.rulesStrings>
    <li>subject->ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ</li>
    <li>subject_FemMas->ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ</li>
    <li>subject_def->ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ</li>
    <li>subject_def2->ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ</li>
    <li>subject_story->ﻭﺣﻴﺪًﺍ ﻛﺎﻣﻞ، ﺟﻴﻞٍ ﺑﻌﺪ ﻭﺍﺳﺘﻴﻘﻆ ﻛﺮﻳﺒﺘﻮﻧﻲ ﺳﺒﺎﺕ ﻟﺘﺎﺑﻮﺕ ﺃﻭﻟﻲ ﻧﻤﻮﺫﺝ ﺍﺧﺘﺒﺎﺭ ﻳﻨﻮﻱ ﻛﺎﻥ</li>
    <li>subject_story->ﺍﻹﻋﺪﺍﻡ ﻣﻦ ﺑﺪﻟًﺎ ﻣﺤﺪﺩ ﻏﻴﺮ ﻛﺮﻳﺒﺘﻮﻧﻲ ﺑﺴﺒﺎﺕ ﺍﻟﻨﻈﺎﻡ ﻓﻲ ﻣﺠﺮﻡ ﺃﺳﻮﺃ ﻋﻠﻰ ﺣﻜﻢ</li>
    <li>subject_story->ﻳﻜﺒﺮﻭﺍ ﺃﻥ ﺑﻌﺪ ﺃﻃﻔﺎﻟﻬﻢ ﺭﺅﻳﺔ ﻣﻦ ﻳﺘﻤﻜﻨﻮﺍ ﻛﻲ ﻋﻀﺎﻝ، ﺑﻤﺮﺽ ﺍﻟﻤﺼﺎﺑﻴﻦ ﺣﺎﻟﺔ ﻟﺘﻌﻠﻴﻖ ﻛﺮﻳﺒﺘﻮﻧﻲ ﺳﺒﺎﺕ ﻛﺒﺴﻮﻟﺔ ﺍﺳﺘﺨﺪﻡ</li>
    <li>subject_gerund->ﺍﻟﻜﺮﻳﺒﺘﻮﻧﻲ ﺍﻟﺴﺒﺎﺕ ﺗﻮﺍﺑﻴﺖ ﺑﻨﺎﺀ</li>
    <li>subject_gerund->ﻛﺮﻳﺒﺘﻮﻧﻲ ﺳﺒﺎﺕ ﻓﻲ ﺍﻵﺧﺮﻳﻦ ﺇﺩﺧﺎﻝ</li>
  </Cryptosleep.generalRules.rulesStrings>
  
  <!-- EN: fabrication -->
  <Fabrication.label>ﺍﻟﺘﺼﻨﻴﻊ</Fabrication.label>
  <!-- EN: Build fabrication benches, capable of high-tech projects ranging from component assembly to power armor construction. -->
  <Fabrication.description>ﺍﻵﻟﻴﺔ ﺍﻟﺪﺭﻭﻉ ﺑﻨﺎﺀ ﺇﻟﻰ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺗﺠﻤﻴﻊ ﻣﻦ ﺗﺘﺮﺍﻭﺡ ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﻣﺸﺎﺭﻳﻊ ﺗﻨﻔﻴﺬ ﻋﻠﻰ ﻗﺎﺩﺭﺓ ﺗﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ ﺍﺑﻦِ.</Fabrication.description>
  <!-- EN: You now have the technology to build a fabrication bench - but it also requires some advanced components to get started. You can collect advanced components several ways:\n\n  -All outlander settlements sell advanced components. Send a caravan to buy some.\n  -Some visiting traders sell advanced components. Invite or wait for them.\n  -Some quests are rewarded with advanced components. -->
  <Fabrication.discoveredLetterText>ﻫﺰﻳﻤﺘﻬﺎ ﻋﻨﺪ ﺗُﺴﻘﻄﻬﺎ ﺍﻟﺨﺎﺻﺔ ﺍﻟﺘﻬﺪﻳﺪﺍﺕ ﺑﻌﺾ - ﻣﺘﻘﺪﻣﺔ ﺑﻤﻜﻮّﻧﺎﺕ ﺗﻜﺎﻓﺊ ﺍﻟﻤﻬﺎﻡ ﺑﻌﺾ ﺍﻧﺘﻈﺮﻫﻢ ﺃﻭ. ﺍﺩﻋُﻬﻢ ﻣﺘﻘﺪﻣﺔ ﻣﻜﻮّﻧﺎﺕ ﻳﺒﻴﻌﻮﻥ ﺍﻟﺰﺍﺋﺮﻳﻦ ﺍﻟﺘﺠﺎﺭ ﺑﻌﺾ:\n\n -ﺑﻌﻀﻬﺎ ﻟﺸﺮﺍﺀ ﻗﺎﻓﻠﺔ ﺃﺭﺳﻞ ﻣﺘﻘﺪﻣﺔ ﻣﻜﻮّﻧﺎﺕ. ﺗﺒﻴﻊ ﺍﻟﻐﺮﺑﺎﺀ ﻣﺴﺘﻮﻃﻨﺎﺕ ﺟﻤﻴﻊ.\n -ﻃﺮﻕ ﺑﻌﺪﺓ ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﻋﻠﻰ ﺍﻟﺤﺼﻮﻝ. ﻳﻤﻜﻨﻚ ﻟﻠﺒﺪﺀ ﺍﻟﻤﺘﻘﺪﻣﺔ.\n -ﺍﻟﻤﻜﻮّﻧﺎﺕ ﺑﻌﺾ ﺃﻳﻀًﺎ ﺗﺘﻄﻠﺐ ﻟﻜﻨﻬﺎ.\n -ﺗﺼﻨﻴﻊ ﻃﺎﻭﻟﺔ ﻟﺒﻨﺎﺀ ﺍﻟﺘﻘﻨﻴﺔ ﺍﻵﻥ ﻟﺪﻳﻚ.</Fabrication.discoveredLetterText>
  <!-- EN: About: Getting advanced components -->
  <Fabrication.discoveredLetterTitle>ﺍﻟﻤﺘﻘﺪﻣﺔ: ﺍﻟﻤﻜﻮّﻧﺎﺕ ﻋﻠﻰ ﺍﻟﺤﺼﻮﻝ ﺣﻮﻝ</Fabrication.discoveredLetterTitle>
  <!-- EN:
    <li>subject->high-tech fabrication benches</li>
    <li>subject_story->spent many years crafting advanced components, to make fabrication benches to make more advanced components</li>
    <li>subject_story->traded everything to build a single fabrication bench</li>
    <li>subject_story->constructed technological marvels which the feral villagers worshipped as magical</li>
    <li>subject_gerund->constructing high-tech projects</li>
    <li>subject_gerund->building high-tech fabrication stations</li>
  -->
  <Fabrication.generalRules.rulesStrings>
    <li>subject->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﺗﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ</li>
    <li>subject_FemMas->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﺍﻟﺘﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ</li>
    <li>subject_def->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﺍﻟﺘﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ</li>
    <li>subject_def2->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﺍﻟﺘﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ</li>
    <li>subject_story->ﺍﻟﻤﺘﻘﺪﻣﺔ ﺍﻟﻤﻜﻮّﻧﺎﺕ ﻣﻦ ﻣﺰﻳﺪًﺍ ﺗﺼﻨﻊ ﺗﺼﻨﻴﻊ ﻃﺎﻭﻻﺕ ﻟﻴﺼﻨﻊ ﻣﺘﻘﺪﻣﺔ ﻣﻜﻮّﻧﺎﺕ ﻳﺼﻨﻊ ﻃﻮﻳﻠﺔ ﺳﻨﻮﺍﺕ ﺃﻣﻀﻰ</li>
    <li>subject_story->ﻭﺍﺣﺪﺓ ﺗﺼﻨﻴﻊ ﻃﺎﻭﻟﺔ ﻟﺒﻨﺎﺀ ﻳﻤﻠﻚ ﻣﺎ ﻛﻞ ﺑﺎﺩﻝ</li>
    <li>subject_story->ﺳﺤﺮ ﺃﻧﻬﺎ ﻋﻠﻰ ﻳﻌﺒﺪﻭﻧﻬﺎ ﺍﻟﻤﺘﻮﺣﺸﻮﻥ ﺍﻟﻘﺮﻭﻳﻮﻥ ﻛﺎﻥ ﺗﻘﻨﻴﺔ ﻋﺠﺎﺋﺐ ﺷﻴّﺪ</li>
    <li>subject_gerund->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﻣﺸﺎﺭﻳﻊ ﺗﻨﻔﻴﺬ</li>
    <li>subject_gerund->ﺍﻟﺘﻘﻨﻴﺔ ﻋﺎﻟﻴﺔ ﺗﺼﻨﻴﻊ ﻣﺤﻄﺎﺕ ﺑﻨﺎﺀ</li>
  </Fabrication.generalRules.rulesStrings>
  
  <!-- EN: multi-analyzer -->
  <MultiAnalyzer.label>ﻣﺘﻌﺪﺩ ﻣﺤﻠﻞ</MultiAnalyzer.label>
  <!-- EN: Build multi-analyzers which increase research speed and allow higher-level research projects. -->
