<LanguageData>
  
  <!-- EN: deep drilling -->
  <DeepDrilling.label>ﺍﻟﻌﻤﻴﻖ ﺍﻟﺤﻔﺮ</DeepDrilling.label>
  <!-- EN: Build deep drills for extracting resources from underground. You'll need a ground-penetrating scanner to find the resources. -->
  <DeepDrilling.description>ﺍﻟﻤﻮﺍﺭﺩ ﻋﻠﻰ ﻟﻠﻌﺜﻮﺭ ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻣﺎﺳﺢ ﺇﻟﻰ ﺳﺘﺤﺘﺎﺝ ﺍﻷﺭﺽ. ﺗﺤﺖ ﻣﻦ ﺍﻟﻤﻮﺍﺭﺩ ﻻﺳﺘﺨﺮﺍﺝ ﻋﻤﻴﻖ ﺣﻔﺮ ﻣﺜﺎﻗﺐ ﺍﺑﻦِ.</DeepDrilling.description>
  <!-- EN:
    <li>subject->deep mining</li>
    <li>subject_story->moved in with a dirtmole-led corp, studying its deepest excavations</li>
    <li>subject_story->drilled down to the ice cap's root to discover the world's extinct prehuman biome</li>
    <li>subject_story->became wealthy from the resources dug out of the world's core</li>
    <li>subject_gerund->mining deeply</li>
  -->
  <DeepDrilling.generalRules.rulesStrings>
    <li>subject->ﺍﻟﻌﻤﻴﻖ ﺍﻟﺘﻌﺪﻳﻦ</li>
    <li>subject_FemMas->ﺍﻟﻌﻤﻴﻖ ﺍﻟﺘﻌﺪﻳﻦ</li>
    <li>subject_def->ﺍﻟﻌﻤﻴﻖ ﻟﻠﺘﻌﺪﻳﻦ</li>
    <li>subject_def2->ﺍﻟﻌﻤﻴﻖ ﺍﻟﺘﻌﺪﻳﻦ ﺇﻟﻰ</li>
    <li>subject_story->ﺣﻔﺮﻳﺎﺗﻬﺎ ﺃﻋﻤﻖ ﻭﺩﺭﺱ ﺍﻟﺪﻳﺮﺗﻤﻮﻝ، ﻓﺼﻴﻠﺔ ﺗﻘﻮﺩﻫﺎ ﺷﺮﻛﺔ ﻣﻊ ﻟﻠﻌﻴﺶ ﺍﻧﺘﻘﻞ</li>
    <li>subject_story->ﺍﻟﻌﺎﻟﻢ ﻓﻲ ﺍﻟﻤﻨﻘﺮﺽ ﺍﻟﺒﺸﺮﻱ ﻗﺒﻞ ﻣﺎ ﺍﻟﺤﻴﻮﻱ ﺍﻹﻗﻠﻴﻢ ﻻﻛﺘﺸﺎﻑ ﺍﻟﺠﻠﻴﺪﻱ ﺍﻟﻐﻄﺎﺀ ﺟﺬﺭ ﺣﺘﻰ ﺣﻔﺮ</li>
    <li>subject_story->ﺍﻟﻌﺎﻟﻢ ﻧﻮﺍﺓ ﻣﻦ ﺍﻟﻤﺴﺘﺨﺮﺟﺔ ﺍﻟﻤﻮﺍﺭﺩ ﻣﻦ ﺛﺮﻳًﺎ ﺃﺻﺒﺢ</li>
    <li>subject_gerund->ﺑﻌﻤﻖ ﺍﻟﺘﻌﺪﻳﻦ</li>
  </DeepDrilling.generalRules.rulesStrings>
  
  <!-- EN: flatscreen television -->
  <FlatscreenTelevision.label>ﻣﺴﻄﺤﺔ ﺑﺸﺎﺷﺔ ﺗﻠﻔﺎﺯ</FlatscreenTelevision.label>
  <!-- EN: Produce high-resolution flatscreen televisions for greater enjoyment. -->
  <FlatscreenTelevision.description>ﺃﻛﺒﺮ ﻟﻤﺘﻌﺔ ﻣﺴﻄﺤﺔ ﺑﺸﺎﺷﺔ ﺍﻟﺪﻗﺔ ﻋﺎﻟﻴﺔ ﺗﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ ﺃﻧﺘﺞ.</FlatscreenTelevision.description>
  <!-- EN:
    <li>subject->flatscreen televisions</li>
    <li>subject_story->experimented with removing tubes from televisions</li>
    <li>subject_story->agitated for galaxy-wide, high-resolution broadcasts of [tv_content]</li>
    <li>tv_content->soap operas</li>
    <li>tv_content->news programmes</li>
    <li>tv_content->revolutionary propaganda</li>
    <li>tv_content->glitterworld fashion</li>
    <li>tv_content->docartoons</li>
    <li>subject_story->became a television executive, in charge of [tv_content]</li>
    <li>subject_gerund->producing flatscreen televisions</li>
  -->
  <FlatscreenTelevision.generalRules.rulesStrings>
    <li>subject->ﻣﺴﻄﺤﺔ ﺑﺸﺎﺷﺔ ﺗﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ</li>
    <li>subject_FemMas->ﺍﻟﻤﺴﻄﺤﺔ ﺍﻟﺸﺎﺷﺔ ﺫﺍﺕ ﺍﻟﺘﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ</li>
    <li>subject_def->ﺍﻟﻤﺴﻄﺤﺔ ﺍﻟﺸﺎﺷﺔ ﺫﺍﺕ ﺍﻟﺘﻠﻔﺎﺯ ﻷﺟﻬﺰﺓ</li>
    <li>subject_def2->ﺍﻟﻤﺴﻄﺤﺔ ﺍﻟﺸﺎﺷﺔ ﺫﺍﺕ ﺍﻟﺘﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ ﺇﻟﻰ</li>
    <li>subject_story->ﺍﻟﺘﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ ﻣﻦ ﺍﻷﻧﺎﺑﻴﺐ ﺇﺯﺍﻟﺔ ﺟﺮّﺏ</li>
    <li>subject_story->ﻟﻤﺤﺘﻮﻯ ﺍﻟﻤﺠﺮﺓ ﻣﺴﺘﻮﻯ ﻋﻠﻰ ﺍﻟﺪﻗﺔ ﻋﺎﻟﻴﺔ ﺑﺜّﺎﺕ ﺃﺟﻞ ﻣﻦ ﻧﺎﺿﻞ [tv_content]</li>
    <li>subject_story->ﻋﻦ ﻣﺴﺆﻭﻟًﺎ ﻟﻠﺘﻠﻔﺰﻳﻮﻥ، ﺗﻨﻔﻴﺬﻳًﺎ ﻣﺪﻳﺮًﺍ ﺃﺻﺒﺢ [tv_content]</li>
    <li>tv_content->ﺩﺭﺍﻣﻴﺔ ﻣﺴﻠﺴﻻﺖ</li>
    <li>tv_content->ﺃﺧﺒﺎﺭ ﺑﺮﺍﻣﺞ</li>
    <li>tv_content->ﺛﻮﺭﻳﺔ ﺩﻋﺎﻳﺔ</li>
    <li>tv_content->ﺍﻟﻐﻠﻴﺘﺮ ﻋﻮﺍﻟﻢ ﻣﻮﺿﺔ</li>
    <li>tv_content->ﻭﺛﺎﺋﻘﻴﺔ ﺭﺳﻮﻡ</li>
    <li>subject_gerund->ﻣﺴﻄﺤﺔ ﺑﺸﺎﺷﺔ ﺗﻠﻔﺎﺯ ﺃﺟﻬﺰﺓ ﺇﻧﺘﺎﺝ</li>
  </FlatscreenTelevision.generalRules.rulesStrings>
  
  <!-- EN: ground-penetrating scanner -->
  <GroundPenetratingScanner.label>ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻣﺎﺳﺢ</GroundPenetratingScanner.label>
  <!-- EN: Build ground-penetrating scanners that can detect drillable resources under the surface. Requires an advanced component to construct. -->
  <GroundPenetratingScanner.description>ﻣﺘﻘﺪﻣًﺎ ﻣﻜﻮّﻧًﺎ ﺍﻟﺒﻨﺎﺀ ﻳﺘﻄﻠﺐ ﺍﻟﺴﻄﺢ ﺗﺤﺖ ﻟﻠﺤﻔﺮ ﺍﻟﻘﺎﺑﻠﺔ ﺍﻟﻤﻮﺍﺭﺩ ﺍﻛﺘﺸﺎﻑ ﻳﻤﻜﻨﻬﺎ. ﺍﻷﺭﺽ ﻻﺧﺘﺮﺍﻕ ﻣﺎﺳﺤﺎﺕ ﺍﺑﻦِ.</GroundPenetratingScanner.description>
  <!-- EN:
    <li>subject->geophysics</li>
    <li>subject->ground-penetrating scanners</li>
    <li>subject_story->discovered the bones of ancient giants, far below the planet's surface</li>
    <li>subject_story->stumbled across a rich gold seam whilst scanning for tin and became fabulously wealthy</li>
    <li>subject_story->scanned the ground for ancient minefields, to protect the people</li>
    <li>subject_gerund->constructing geophysical scanners</li>
  -->
  <GroundPenetratingScanner.generalRules.rulesStrings>
    <li>subject->ﺍﻟﺠﻴﻮﻟﻮﺟﻴﺔ ﺍﻟﻔﻴﺰﻳﺎﺀ</li>
    <li>subject_FemMas->ﺍﻟﺠﻴﻮﻟﻮﺟﻴﺔ ﺍﻟﻔﻴﺰﻳﺎﺀ</li>
    <li>subject->ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻣﺎﺳﺤﺎﺕ</li>
    <li>subject_FemMas->ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻣﺎﺳﺤﺎﺕ</li>
    <li>subject_def->ﺍﻟﺠﻴﻮﻟﻮﺟﻴﺔ ﻟﻠﻔﻴﺰﻳﺎﺀ</li>
    <li>subject_def2->ﺍﻟﺠﻴﻮﻟﻮﺟﻴﺔ ﺍﻟﻔﻴﺰﻳﺎﺀ ﺇﻟﻰ</li>
    <li>subject_def->ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻟﻤﺎﺳﺤﺎﺕ</li>
    <li>subject_def2->ﺍﻷﺭﺽ ﺍﺧﺘﺮﺍﻕ ﻣﺎﺳﺤﺎﺕ ﺇﻟﻰ</li>
    <li>subject_story->ﺍﻟﻜﻮﻛﺐ ﺳﻄﺢ ﺗﺤﺖ ﻋﻤﻴﻘًﺎ ﻗﺪﻣﺎﺀ، ﻋﻤﺎﻟﻘﺔ ﻋﻈﺎﻡ ﺍﻛﺘﺸﻒ</li>
    <li>subject_story->ﻓﺎﺣﺸًﺎ ﺛﺮﺍﺀً ﺛﺮﻳًﺎ ﻭﺃﺻﺒﺢ ﺍﻟﻘﺼﺪﻳﺮ ﻋﻦ ﺑﺤﺜًﺎ ﺍﻟﻤﺴﺢ ﺃﺛﻨﺎﺀ ﻏﻨﻲ ﺫﻫﺐ ﻋِﺮﻕ ﻋﻠﻰ ﻣﺼﺎﺩﻓﺔً ﻋﺜﺮ</li>
    <li>subject_story->ﺍﻟﻨﺎﺱ ﻟﺤﻤﺎﻳﺔ ﻗﺪﻳﻤﺔ ﺃﻟﻐﺎﻡ ﺣﻘﻮﻝ ﻋﻦ ﺑﺤﺜًﺎ ﺍﻷﺭﺽ ﻣﺴﺢ</li>
    <li>subject_gerund->ﺟﻴﻮﻓﻴﺰﻳﺎﺋﻴﺔ ﻣﺎﺳﺤﺎﺕ ﺑﻨﺎﺀ</li>
  </GroundPenetratingScanner.generalRules.rulesStrings>
  
  <!-- EN: autocannon turret -->
  <HeavyTurrets.label>ﺁﻟﻲ ﻣﺪﻓﻊ ﺑﺮﺝ</HeavyTurrets.label>
  <!-- EN: Produce the heavy autocannon turret. -->
  <HeavyTurrets.description>ﺍﻟﻤﺴﺘﻌﻤﺮﺓ ﻋﻦ ﻟﻠﺪﻓﺎﻉ ﺍﻟﻤﺪﻯ ﺑﻌﻴﺪﺓ ﺛﻘﻴﻠﺔ ﺁﻟﻴﺔ ﻣﺪﺍﻓﻊ ﺃﺑﺮﺍﺝ ﺍﺑﻦِ.</HeavyTurrets.description>
  <!-- EN:
    <li>subject->autocannon turrets</li>
    <li>subject_story->held off a cultist assault alone, hiding behind a wall of turrets</li>
    <li>subject_story->was hired to establish a defensive perimeter of sandbags and turrets for the locals</li>
    <li>subject_story->built turret after turret, never asking who was buying them</li>
    <li>subject_gerund->crafting heavy autocannon turrets</li>
  -->
  <HeavyTurrets.generalRules.rulesStrings>
    <li>subject->ﺁﻟﻴﺔ ﻣﺪﺍﻓﻊ ﺃﺑﺮﺍﺝ</li>
    <li>subject_FemMas->ﺍﻵﻟﻴﺔ ﺍﻟﻤﺪﺍﻓﻊ ﺃﺑﺮﺍﺝ</li>
    <li>subject_def->ﺍﻵﻟﻴﺔ ﺍﻟﻤﺪﺍﻓﻊ ﻷﺑﺮﺍﺝ</li>
    <li>subject_def2->ﺍﻵﻟﻴﺔ ﺍﻟﻤﺪﺍﻓﻊ ﺃﺑﺮﺍﺝ ﺇﻟﻰ</li>
    <li>subject_story->ﺍﻷﺑﺮﺍﺝ ﻣﻦ ﺟﺪﺍﺭ ﺧﻠﻒ ﻣﺨﺘﺒﺌًﺎ ﻭﺣﺪﻩ، ﻟﻄﺎﺋﻔﻴﻴﻦ ﻫﺠﻮﻣًﺎ ﺻﺪّ</li>
    <li>subject_story->ﺍﻟﻤﺤﻠﻴﻴﻦ ﺍﻟﺴﻜﺎﻥ ﻟﺼﺎﻟﺢ ﻭﺍﻷﺑﺮﺍﺝ ﺍﻟﺮﻣﻞ ﺃﻛﻴﺎﺱ ﻣﻦ ﺩﻓﺎﻋﻲ ﻣﺤﻴﻂ ﻹﻧﺸﺎﺀ ﺗﻮﻇﻴﻔﻪ ﺗﻢ</li>
    <li>subject_story->ﻳﺸﺘﺮﻳﻬﺎ ﻛﺎﻥ ﻣﻦ ﻳﺴﺄﻝ ﺃﻥ ﺩﻭﻥ ﺍﻵﺧﺮ ﺗﻠﻮ ﺑﺮﺟًﺎ ﺑﻨﻰ</li>
    <li>subject_gerund->ﺛﻘﻴﻠﺔ ﺁﻟﻴﺔ ﻣﺪﺍﻓﻊ ﺃﺑﺮﺍﺝ ﺗﺼﻨﻴﻊ</li>
  </HeavyTurrets.generalRules.rulesStrings>
  
  <!-- EN: hospital bed -->
  <HospitalBed.label>ﻣﺴﺘﺸﻔﻰ ﺳﺮﻳﺮ</HospitalBed.label>
  <!-- EN: Construct hospital beds which improve medical outcomes. -->
  <HospitalBed.description>ﺍﻟﻄﺒﻲ ﺍﻟﻌﻻﺞ ﻧﺘﺎﺋﺞ ﺗﺤﺴّﻦ ﻣﺴﺘﺸﻔﻰ ﺃﺳﺮّﺓ ﺍﺑﻦِ.</HospitalBed.description>
